NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CDN_URL=

NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Milliseconds since the last interactive sign-in before the donation form offers to switch accounts. Default 4 hours. Set 0 to always show the link while testing.
NEXT_PUBLIC_SWITCH_ACCOUNT_AFTER_MS=

NEXT_PUBLIC_ALLOW_FEE_COLLECTION=true
NEXT_PUBLIC_ENABLE_FUNDRAISER_CITIES=false

NEXT_PUBLIC_DISABLE_APPLE_PAY=false
NEXT_PUBLIC_DISABLE_GOOGLE_PAY=false

UNSPLASH_ACCESS_KEY=

NEXT_PUBLIC_SENTRY_DSN=

# Host only, no scheme, no path, no trailing slash
NEXT_PUBLIC_APP_HOST=www.startplanting.org

# Self-hosted Umami, which also serves the heatmap recorder.
# Origin only, no trailing slash: script.js and recorder.js are appended to it.
# Leave empty to switch analytics off. Any host these are set on reports, so give previews and staging their own website id rather than the production one.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional, true by default. Set to false to stop this box sending visits and donation events to Umami (for example locally). Insights still work, since they only read stats.
COLLECT_INSIGHTS=
# Server only. Reads page views and donation events for the fundraiser dashboard. Use a key from a view-only Umami user; never prefix it with NEXT_PUBLIC_.
UMAMI_API_KEY=
# Optional. The website to read stats from, when it differs from the one this box reports to (for example, reading production stats locally).
UMAMI_STATS_WEBSITE_ID=

# HMAC key for the TRACKING-ID header on anonymous donation requests.
# Leave empty locally. Required in production, or anonymous donations are not created.
NEXT_PUBLIC_TRACKING_KEY=
